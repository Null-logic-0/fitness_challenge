---
import { useTranslations, getLocalizedPath, localeTags } from '../i18n/utils.js';
import { formatNumber } from '../utils/format.js';
import { getCountryName } from '../utils/countries.js';

/**
 * Compact athlete summary card, used on the athletes index.
 * @typedef {Object} Props
 * @property {string} lang
 * @property {{handle:string,name:string,country:string,total:number,rank:number,verified?:boolean}} athlete
 */
const { lang, athlete } = Astro.props;
const t = useTranslations(lang);

function initials(name) {
  return name.split(' ').map((p) => p[0]).slice(0, 2).join('').toUpperCase();
}
---

<a
  href={getLocalizedPath(lang, `/athletes/${athlete.handle}`)}
  class="flex items-center gap-4 rounded-box border border-base-300 bg-base-200 p-4 transition-colors hover:border-primary focus-ring"
>
  <div class="avatar avatar-placeholder shrink-0">
    <div class="w-12 rounded-full bg-base-300 text-base-content">
      <span class="text-sm font-semibold">{initials(athlete.name)}</span>
    </div>
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <p class="truncate font-semibold">{athlete.name}</p>
      {athlete.verified && (
        <span class="badge badge-info badge-sm shrink-0" title={t('athlete.verified')}>✓</span>
      )}
    </div>
    <p class="text-xs text-base-content/50">{athlete.country && <>{getCountryName(athlete.country, localeTags[lang])} · </>}#{athlete.rank}</p>
  </div>
  <div class="text-right">
    <p class="font-stat text-2xl font-bold">{formatNumber(lang, athlete.total)}</p>
    <p class="text-[10px] font-semibold uppercase tracking-wider text-base-content/40">{t('athlete.personalBest')}</p>
  </div>
</a>
