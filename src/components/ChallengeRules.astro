---
import { useTranslations, getDictionary } from '../i18n/utils.js';

const { lang } = Astro.props;
const t = useTranslations(lang);
const dict = getDictionary(lang).rules;
---

<section id="rules" class="border-b border-base-300 bg-base-200 scroll-mt-16">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <p class="font-stat text-xs font-semibold tracking-[0.2em] text-primary">{t('rules.eyebrow')}</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{t('rules.title')}</h2>
    <p class="mt-2 max-w-md text-base-content/60">{t('rules.subtitle')}</p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-box border border-base-300 bg-base-100 p-6">
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-semibold">{dict.pullUps.title}</h3>
          <span class="badge badge-success gap-1 font-semibold">
            <svg viewBox="0 0 16 16" class="h-3 w-3 fill-current" aria-hidden="true"><path d="M6.5 11.5 3 8l1.4-1.4 2.1 2.1 5.1-5.1L13 5z"/></svg>
            {t('rules.validRep')}
          </span>
        </div>

        <div class="mt-4 flex flex-col gap-4 sm:flex-row">
          <div class="shrink-0 self-start overflow-hidden rounded-field border border-base-300 sm:w-36">
            <video
              class="aspect-[720/1300] w-full object-cover"
              controls
              playsinline
              preload="metadata"
              poster="/videos/pull-ups-tutorial-poster.jpg"
              aria-label={dict.pullUps.title}
            >
              <source src="/videos/pull-ups-tutorial-web.mp4" type="video/mp4" />
            </video>
          </div>
          <ul class="flex-1 space-y-3">
            {dict.pullUps.items.map((item) => (
              <li class="flex gap-3 text-sm text-base-content/75">
                <span class="mt-0.5 text-primary" aria-hidden="true">—</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-6">
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-semibold">{dict.dips.title}</h3>
          <span class="badge badge-success gap-1 font-semibold">
            <svg viewBox="0 0 16 16" class="h-3 w-3 fill-current" aria-hidden="true"><path d="M6.5 11.5 3 8l1.4-1.4 2.1 2.1 5.1-5.1L13 5z"/></svg>
            {t('rules.validRep')}
          </span>
        </div>

        <div class="mt-4 flex flex-col gap-4 sm:flex-row">
          <div class="shrink-0 self-start overflow-hidden rounded-field border border-base-300 sm:w-36">
            <video
              class="aspect-[720/1300] w-full object-cover"
              controls
              playsinline
              preload="metadata"
              poster="/videos/dips-tutorial-poster.jpg"
              aria-label={dict.dips.title}
            >
              <source src="/videos/dips-tutorial-web.mp4" type="video/mp4" />
            </video>
          </div>
          <ul class="flex-1 space-y-3">
            {dict.dips.items.map((item) => (
              <li class="flex gap-3 text-sm text-base-content/75">
                <span class="mt-0.5 text-primary" aria-hidden="true">—</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
