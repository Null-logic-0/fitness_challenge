---
import { useTranslations, getDictionary } from '../i18n/utils.js';

const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = getDictionary(lang).howItWorks.steps;
---

<section id="how-it-works" class="border-b border-base-300 bg-base-100 scroll-mt-16">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <p class="font-stat text-xs font-semibold tracking-[0.2em] text-primary">{t('howItWorks.eyebrow')}</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{t('howItWorks.title')}</h2>
    <p class="mt-2 max-w-md text-base-content/60">{t('howItWorks.subtitle')}</p>

    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <li class="border-t-2 border-primary pt-4">
          <span class="font-stat text-3xl font-bold text-base-content/30">{step.number}</span>
          <h3 class="mt-2 text-lg font-semibold">{step.title}</h3>
          <p class="mt-1 text-sm text-base-content/60">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
