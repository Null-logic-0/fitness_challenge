---
/**
 * A single platform-stat tile. Renders a "—" placeholder — the real value
 * is filled in client-side from the `platform_stats` view (see
 * src/scripts/platform-stats.js) since the homepage stays fully static.
 * @typedef {Object} Props
 * @property {string} statKey - matches a column on public.platform_stats (athletes, attempts, currentRecord, averageScore)
 * @property {string} label
 */
const { statKey, label } = Astro.props;
---

<div class="rounded-box border border-base-300 bg-base-100 p-6">
  <p class="font-stat text-4xl font-bold sm:text-5xl" data-stat={statKey}>—</p>
  <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-base-content/50">{label}</p>
</div>
