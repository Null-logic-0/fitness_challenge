---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import ScoreCard from '../../../components/ScoreCard.astro';
import ShareCard from '../../../components/ShareCard.astro';
import Footer from '../../../components/Footer.astro';
import { supabase } from '../../../db/supabase.js';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils.js';
import { formatNumber, formatDate } from '../../../utils/format.js';
import { youtubeEmbedUrl } from '../../../utils/youtube.js';

const { lang, id } = Astro.params;
const t = useTranslations(lang);

const { data: result } = await supabase
  .from('results')
  .select('id, user_id, pull_ups, dips, total, youtube_video_id, status, submitted_at')
  .eq('id', id)
  .single();

let profile = null;
let isPersonalBest = false;

if (result) {
  const [{ data: profileData }, { data: bestData }] = await Promise.all([
    supabase.from('profiles').select('username, display_name, country').eq('id', result.user_id).single(),
    supabase.from('leaderboard').select('result_id').eq('user_id', result.user_id).single(),
  ]);
  profile = profileData;
  isPersonalBest = bestData?.result_id === result.id;
}

const shareUrl = new URL(getLocalizedPath(lang, `/results/${id}`), Astro.site).toString();

const statusLabel = {
  pending: t('results.statusPending'),
  verified: t('results.statusVerified'),
  rejected: t('results.statusRejected'),
}[result?.status] ?? '';

const statusBadgeClass = {
  pending: 'badge-warning',
  verified: 'badge-success',
  rejected: 'badge-error',
}[result?.status] ?? 'badge-neutral';

const title = result
  ? `${formatNumber(lang, result.total)} ${t('share.totalRepsLabel')} — ${profile?.display_name ?? ''} — 5MIN`
  : `${t('results.notFoundTitle')} — 5MIN`;

const description = result
  ? `${formatNumber(lang, result.pull_ups)} ${t('challenge.pullUps')}, ${formatNumber(lang, result.dips)} ${t('challenge.dips')}. ${t('share.canYouBeat')}`
  : t('results.notFoundBody');
---

<Layout lang={lang} title={title} description={description} path={`/results/${id}`}>
  <Navbar lang={lang} path={`/results/${id}`} />
  <main id="main-content" class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
    {result ? (
      <>
        <div class="rounded-box border border-base-300 bg-base-200 p-8 text-center">
          <div class="flex items-center justify-center gap-2">
            <span class={`badge ${statusBadgeClass} font-semibold`}>{statusLabel}</span>
            {isPersonalBest && <span class="badge badge-primary font-semibold">{t('results.personalBestBadge')}</span>}
          </div>

          {profile && (
            <a href={getLocalizedPath(lang, `/athletes/${profile.username}`)} class="mt-3 inline-block text-sm font-semibold text-primary focus-ring rounded-field">
              {profile.display_name}
            </a>
          )}

          <div class="mt-4">
            <ScoreCard
              lang={lang}
              total={result.total}
              pullUps={result.pull_ups}
              dips={result.dips}
              totalLabel={t('share.totalRepsLabel')}
              pullUpsLabel={t('challenge.pullUps')}
              dipsLabel={t('challenge.dips')}
              size="xl"
            />
          </div>

          <p class="mt-4 text-xs text-base-content/50">
            {t('results.submittedOn').replace('{date}', formatDate(lang, result.submitted_at))}
          </p>
        </div>

        <div class="mt-6 overflow-hidden rounded-box border border-base-300">
          <div class="aspect-video">
            <iframe
              class="h-full w-full"
              src={youtubeEmbedUrl(result.youtube_video_id)}
              title={t('results.watchOnYoutube')}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>

        <div class="mt-10">
          <ShareCard
            lang={lang}
            total={result.total}
            pullUps={result.pull_ups}
            dips={result.dips}
            isPersonalBest={isPersonalBest}
            shareUrl={shareUrl}
            resultId={result.id}
          />
        </div>

        <div class="mt-8 text-center">
          <a href={getLocalizedPath(lang, '/leaderboard')} class="btn btn-ghost focus-ring">{t('results.viewLeaderboard')}</a>
        </div>
      </>
    ) : (
      <div class="rounded-box border border-base-300 bg-base-200 p-12 text-center">
        <p class="text-xl font-semibold">{t('results.notFoundTitle')}</p>
        <p class="mt-2 text-sm text-base-content/60">{t('results.notFoundBody')}</p>
        <a href={getLocalizedPath(lang, '/challenge')} class="btn btn-primary mt-6 focus-ring">{t('nav.start')}</a>
      </div>
    )}
  </main>
  <Footer lang={lang} />
</Layout>
