---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SubmissionCard from '../../components/SubmissionCard.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, localizedStaticPaths } from '../../i18n/utils.js';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${t('submit.title')} — 5MIN`} description={t('submit.subtitle')} path="/submit">
  <Navbar lang={lang} path="/submit" />
  <main id="main-content" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-14">
    <div class="mx-auto max-w-lg text-center">
      <p class="font-stat text-xs font-semibold tracking-[0.2em] text-primary">{t('submit.eyebrow')}</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{t('submit.title')}</h1>
      <p class="mt-1 text-base-content/60">{t('submit.subtitle')}</p>
    </div>

    <div class="mt-8">
      <SubmissionCard lang={lang} />
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
