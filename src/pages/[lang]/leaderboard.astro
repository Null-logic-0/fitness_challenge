---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Leaderboard from '../../components/Leaderboard.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils.js';

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${t('leaderboard.title')} — 5MIN`} description={t('leaderboard.subtitle')} path="/leaderboard">
  <Navbar lang={lang} path="/leaderboard" />
  <main id="main-content" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-14">
    <p class="font-stat text-xs font-semibold tracking-[0.2em] text-primary">{t('leaderboard.eyebrow')}</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{t('leaderboard.title')}</h1>
    <p class="mt-1 text-base-content/60">{t('leaderboard.subtitle')}</p>

    <div class="mt-8">
      <Leaderboard lang={lang} />
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
