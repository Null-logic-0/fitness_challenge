---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import Navbar from '../../../../components/Navbar.astro';
import Footer from '../../../../components/Footer.astro';
import { supabase } from '../../../../db/supabase.js';
import { useTranslations, getLocalizedPath } from '../../../../i18n/utils.js';
import { formatNumber } from '../../../../utils/format.js';

const { lang, token } = Astro.params;
const t = useTranslations(lang);

const { data: invite } = await supabase
  .from('invites')
  .select('id, token, result_id, results:result_id(pull_ups, dips, total, user_id, profiles:user_id(display_name, username))')
  .eq('token', token)
  .single();

const inviterName = invite?.results?.profiles?.display_name ?? '';
const score = invite?.results?.total ?? 0;

const inviteTitle = t('social.inviteTitle').replace('{name}', inviterName).replace('{score}', formatNumber(lang, score));
const challengePath = getLocalizedPath(lang, '/challenge');
const registerPath = getLocalizedPath(lang, '/register');

const config = JSON.stringify({ token, challengePath, registerPath });

const pageTitle = invite ? `${inviteTitle} — 5MIN` : `${t('social.inviteNotFoundTitle')} — 5MIN`;
const pageDescription = invite ? t('social.inviteCanYouBeat') : t('social.inviteNotFoundBody');
---

<Layout lang={lang} title={pageTitle} description={pageDescription} path={`/challenge/invite/${token}`} noindex>
  <Navbar lang={lang} path={`/challenge/invite/${token}`} />
  <main id="main-content" class="mx-auto max-w-lg px-4 py-16 sm:px-6">
    {invite ? (
      <div class="rounded-box border border-base-300 bg-base-200 p-8 text-center">
        <p class="font-stat text-xs font-semibold tracking-[0.2em] text-primary">{t('social.challengeSomeone').toUpperCase()}</p>
        <p class="mt-3 text-xl font-semibold">{inviteTitle}</p>

        <p class="font-stat mt-6 text-7xl font-bold">{formatNumber(lang, score)}</p>
        <p class="text-xs font-semibold uppercase tracking-wider text-base-content/50">{t('share.totalRepsLabel')}</p>
        <div class="mt-4 flex justify-center gap-8 text-sm">
          <p><span class="font-stat font-bold">{formatNumber(lang, invite.results?.pull_ups ?? 0)}</span> {t('challenge.pullUps')}</p>
          <p><span class="font-stat font-bold">{formatNumber(lang, invite.results?.dips ?? 0)}</span> {t('challenge.dips')}</p>
        </div>

        <p class="mt-6 text-lg font-semibold text-base-content/80">{t('social.inviteCanYouBeat')}</p>

        <button type="button" id="accept-invite-btn" data-config={config} class="btn btn-primary btn-lg mt-8 w-full focus-ring">
          {t('social.acceptChallenge')}
        </button>
      </div>
    ) : (
      <div class="rounded-box border border-base-300 bg-base-200 p-12 text-center">
        <p class="text-xl font-semibold">{t('social.inviteNotFoundTitle')}</p>
        <p class="mt-2 text-sm text-base-content/60">{t('social.inviteNotFoundBody')}</p>
        <a href={challengePath} class="btn btn-primary mt-6 focus-ring">{t('nav.start')}</a>
      </div>
    )}
  </main>
  <Footer lang={lang} />
</Layout>

<script>
  import { initInviteLanding } from '../../../../scripts/invite-landing.js';
  const btn = document.getElementById('accept-invite-btn');
  if (btn) initInviteLanding(btn, JSON.parse(btn.dataset.config));
</script>
